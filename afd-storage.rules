rules_version = '2';
/*  Audio First Dictionary — Cloud Storage rules
 *  ------------------------------------------------------------------
 *  COMPLETE, STANDALONE FILE for the AFD's own Firebase project.
 *  Deploy as-is. Nothing to merge.
 *
 *  Paths:
 *    afd/{uid}/{recordingId}.webm      — contributed corpus audio
 *    afd_withdrawals/{uid}/{fileName}  — spoken-Hakli consent-withdrawal proof
 *    afd_ui/{fileName}                 — the app's spoken Hakli interface
 *    afd_pics/{uid}/{entryId}.jpg      — a contributor's photo for a word they added
 *
 *  Corpus audio is readable only while its recording doc is public, and
 *  afd_ui/ writes follow the Firestore recording window — both via
 *  cross-service firestore.get(). Run scripts/audit-recording-paths.mjs
 *  before deploying, so older takes don't go silent.
 *
 *  Anonymous sign-in exists ONLY for the UI-prompt recorder and is
 *  boxed into afd_ui/ (and only while the recording window is open).
 *  It cannot write corpus audio.
 *
 *  Deploy:   firebase deploy --only storage
 */
service firebase.storage {
  match /b/{bucket}/o {
    // Cross-service lookups into Firestore (billed reads). On first deploy the
    // CLI asks to let Storage read Firestore — say yes.
    function isSteward() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous'
             && firestore.exists(/databases/(default)/documents/afd_admins/$(request.auth.uid));
    }
    function uiRecordingOpen() {
      return firestore.exists(/databases/(default)/documents/afd_ui_config/recording)
             && firestore.get(/databases/(default)/documents/afd_ui_config/recording).data.openUntil > request.time;
    }
    function publicTake(uid, fileName) {
      return resource.metadata != null
             && resource.metadata.get('entryId', null) is string
             && resource.metadata.get('recordingId', null) is string
             && publicTakeDoc(
                  firestore.get(/databases/(default)/documents/afd_entries/$(resource.metadata.entryId)/recordings/$(resource.metadata.recordingId)),
                  'afd/' + uid + '/' + fileName);
    }
    function publicTakeDoc(d, path) {
      return d != null
             && d.data.allowPlayback == true
             && d.data.get('storagePath', '') == path;
    }

    match /afd/{uid}/{fileName} {
      // Listening follows consent: anyone may fetch a take whose recording doc
      // is public RIGHT NOW (allowPlayback), and the uploader may always fetch
      // their own. The doc is found from the entryId/recordingId the recorder
      // stamps into the object's metadata; requiring the doc's storagePath to be
      // THIS file stops metadata from borrowing another take's public doc.
      // (Rules gate getDownloadURL/getBytes. A link already handed out carries a
      // token that bypasses rules — the afd-revoke Function rotates that token
      // when a take is withdrawn.) Billed: one Firestore read per fetch.
      allow read: if (request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.uid == uid)
                  || publicTake(uid, fileName);
      // only the signed-in, NON-anonymous owner may upload, audio only, 10 MB cap.
      // resource == null makes recordings write-once: a content overwrite is
      // evaluated as create (not update) in Storage rules, so immutability is
      // enforced here rather than via `allow update`.
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == uid
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      // recordings are immutable once uploaded
      allow update: if false;
      allow delete: if false;
    }
    // ---------------- consent-withdrawal proof ----------------
    // The spoken-Hakli artifact that lets an AGENT (a steward acting for a
    // speaker who cannot tap a toggle themselves) withdraw or erase that
    // speaker's takes — the Firestore rule requires withdrawal.audioPath, and
    // this is where those bytes live. It is EVIDENCE, not corpus and not public:
    //   • only the signed-in, non-anonymous owner may write it,
    //   • only that owner may read it back (to replay/confirm before applying),
    //   • it is immutable once written — a withdrawal proof can't be edited away.
    match /afd_withdrawals/{uid}/{fileName} {
      allow read:   if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == uid;
      // resource == null makes this truly write-once: in Storage rules a content
      // overwrite is evaluated as create (not update), so immutability must be
      // enforced here, not via `allow update`.
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == uid
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }
    // ---------------- consent GRANT proof ----------------
    // The mirror of the withdrawal proof: the spoken-Hakli artifact of a speaker
    // GIVING consent (their "yes"), for the proxied case where a steward records
    // on their behalf. Same guarantees as the withdrawal proof — private
    // EVIDENCE, owner-only read, write-once — because a grant you can quietly
    // edit later is no grant at all. The Firestore rule that will REQUIRE
    // grant.audioPath for a proxied speaker is the follow-on step; these bytes
    // are where it looks.
    match /afd_consents/{uid}/{fileName} {
      allow read:   if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == uid
                    && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }
    // ---------------- UI voice prompts ----------------
    // Recorded remotely over anonymous sign-in; played openly by the app.
    // 25 MB cap — the consent narration is a longer connected phrase.
    match /afd_ui/{fileName} {
      allow read: if true;
      // Writes follow the SAME recording window as the afd_ui_prompts doc in
      // Firestore (afd_ui_config/recording, set from prompts/admin.html): while
      // it is open, the anonymous prompt-tool session may record; once it lapses
      // only a steward (afd_admins) can. Replaces the old hand-deployed
      // afd-storage.rules.frozen — the window now closes Storage by itself.
      allow create, update: if request.auth != null
                    && (uiRecordingOpen() || isSteward())
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow delete: if false;
    }
    // ---------------- contributor avatar (opt-in "known" profile) ----------------
    // A steward's OWN profile picture, shown on their voices only while they have
    // chosen to be "known". Enforcement is by PRESENCE, not rule logic: the app
    // deletes this file when the steward switches back to "obscure", so an obscure
    // profile simply has no avatar to fetch. That keeps the read a plain public
    // read (no per-fetch Firestore lookup) and is sufficient here because this is
    // the person's own face and their own visibility choice — not a proxied elder.
    //   • public read (a "known" avatar is meant to be seen),
    //   • owner-only, NON-anonymous write; raster image only, 2 MB cap,
    //   • MUTABLE (change your picture) and deletable (switch back to obscure).
    // resource==null on write is a delete; otherwise it is a create/overwrite and
    // the new bytes are size- and type-checked.
    match /afd_avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && request.auth.uid == uid
                   && ( request.resource == null
                        || ( request.resource.size < 2 * 1024 * 1024
                             && request.resource.contentType.matches('image/(png|jpeg|webp)') ) );
    }
    // ---------------- word photos ("show it", add.html) ----------------
    // The picture a contributor gives a NEW word they add. The entry doc names
    // it by its public URL, and the Firestore rule only accepts this account's
    // own afd_pics/{uid}/{entryId}.jpg, so a picture belongs to one word.
    //   • public read — it's the word's face in the dictionary,
    //   • owner-only, NON-anonymous create; JPEG only (the page re-encodes every
    //     photo to a 512px square, which also drops camera EXIF/GPS), 2 MB cap,
    //   • write-once like the audio (resource == null) — an entry can't be
    //     edited, so neither can its picture,
    //   • only a steward may delete (taking down a photo that shouldn't be there).
    match /afd_pics/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == uid
                    && resource == null
                    && fileName.matches('ent_u_[a-z0-9]{1,40}[.]jpg')
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';
      allow update: if false;
      allow delete: if isSteward();
    }
    // everything else is closed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
