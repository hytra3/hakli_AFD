# dependencies
node_modules/

# firebase emulator / debug logs
*-debug.log
firestore-debug.log
firebase-debug.log

# pre-refactor backups (safe to delete)
*.bak

# python build artifacts (from local function syntax checks)
__pycache__/
*.pyc

# gcloud function source bundles
**/function-source.zip

# working patch files (keep the one tracked exception)
*.patch
*.csv

# credentials & secrets — never commit
serviceAccount*.json
*serviceaccount*.json
*-adminsdk-*.json
.env
.env.*
