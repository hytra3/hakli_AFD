   <section class="demo" id="demo">
     <h2 class="demo-lead" id="demoLead">شاهد كيف يعمل</h2>
     <div class="demo-frame">
-      <iframe title="Hakli walkthrough" src="hakli-welcome-walkthrough.html?embed=1" loading="lazy" scrolling="no"></iframe>
