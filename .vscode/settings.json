{
  // The only JavaScript in this project is inline in index.html / find.html,
  // split across a module <script> and a classic <script>. VS Code analyzes both
  // blocks as one scope, so it wrongly flags the Firestore `db` (module) and the
  // IndexedDB `db` (classic) — and the two `$` helpers — as redeclarations. They
  // live in separate runtime scopes and never actually clash.
  //
  // `html.validate.scripts` is the one that covers scripts embedded in HTML;
  // `javascript.validate.enable` is kept for good measure. Real runtime errors
  // still surface in the browser console.
  "html.validate.scripts": false,
}
