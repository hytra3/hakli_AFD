<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Hakli — speak to find</title>
<style>
  /* ---------------------------------------------------------------- tokens
     Dhofar khareef: monsoon fog, juniper mountain, frankincense resin.
     Deliberately NOT cream + terracotta. */
  :root{
    --fog:#EAF0EE;         /* cool misty background            */
    --cloud:#FFFFFF;       /* raised surfaces                  */
    --mountain:#1F3A34;    /* deep juniper — primary ink       */
    --mist:#8CA39B;        /* muted sage — secondary           */
    --mist-2:#C4D2CC;      /* faint sage — strips, dividers    */
    --resin:#C6873F;       /* frankincense amber — LIVE only   */
    --resin-soft:#E7C9A0;
    --ink:#17241F;
    --shadow:24px 24px 60px rgba(31,58,52,.10);
    --r:22px;
    --tap:96px;            /* minimum comfortable touch target */
    --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:
      radial-gradient(120% 80% at 50% -10%, #F3F7F5 0%, var(--fog) 55%, #DFE8E4 100%) fixed;
    color:var(--ink); font-family:var(--sans);
    -webkit-tap-highlight-color:transparent;
    display:flex; flex-direction:column; min-height:100dvh;
  }
  /* ---------------------------------------------------------------- header */
  header{
    display:flex; align-items:center; gap:10px;
    padding:18px 20px calc(6px + env(safe-area-inset-top));
    color:var(--mountain);
  }
  .mark{width:30px;height:30px;flex:0 0 auto}
  .wordmark{font-family:var(--serif); font-size:20px; letter-spacing:.2px}
  .wordmark small{color:var(--mist); font-family:var(--sans); font-size:12px; letter-spacing:.12em; text-transform:uppercase; margin-inline-start:8px}
  .skin{margin-inline-start:auto; width:42px; height:42px; flex:0 0 auto; border-radius:50%;
        border:1px solid var(--hairline); background:var(--cloud); color:var(--mountain);
        display:grid; place-items:center; cursor:pointer; box-shadow:0 2px 8px rgba(31,58,52,.10)}
  .skin svg{width:20px;height:20px}
  .skin .lbl{font-family:var(--serif); font-size:18px; line-height:1}

  /* ---------------------------------------------------------------- hero */
  main{flex:1; display:flex; flex-direction:column; align-items:center; padding:0 20px 32px}
  /* idle: the mic is a centered hero */
  body:not(.has-results) main{justify-content:center}
  /* results: everything rides up to the top, mic stays put and shrinks */
  body.has-results main{justify-content:flex-start}

  /* the mic + hint live together in a zone that sticks to the top while
     results scroll underneath — so the mic never wanders off-screen and a
     re-tap is always in the same place */
  .control{width:100%; max-width:560px; display:flex; flex-direction:column;
           align-items:center; gap:16px; padding:14px 0 12px;
           position:sticky; top:0; z-index:5;
           background:linear-gradient(var(--fog) 74%, rgba(234,240,238,0))}

  .stage{position:relative; width:min(66vw,248px); aspect-ratio:1;
         transition:width .35s ease}
  body.has-results .stage{width:104px}
  .ring{position:absolute; inset:0; border-radius:50%; border:2px solid var(--mist-2);
        opacity:0; transform:scale(.6)}
  body.rec .ring{animation:ripple 1.8s ease-out infinite}
  .ring:nth-child(2){animation-delay:.6s}
  .ring:nth-child(3){animation-delay:1.2s}
  @keyframes ripple{0%{opacity:.6;transform:scale(.62)}100%{opacity:0;transform:scale(1.25)}}

  .mic{
    position:absolute; inset:0; margin:auto; width:100%; height:100%;
    border:none; border-radius:50%; cursor:pointer; color:var(--cloud);
    background:radial-gradient(120% 120% at 30% 25%, #2C5349 0%, var(--mountain) 70%);
    box-shadow:var(--shadow), inset 0 2px 0 rgba(255,255,255,.14);
    display:grid; place-items:center; transition:transform .18s ease, background .2s ease;
    touch-action:none; user-select:none;
  }
  .mic:active{transform:scale(.97)}
  body:not(.rec):not(.busy) .mic{animation:breathe 4.5s ease-in-out infinite}
  @keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
  body.rec .mic{background:radial-gradient(120% 120% at 30% 25%, #D89A54 0%, var(--resin) 75%)}
  body.busy .mic{background:radial-gradient(120% 120% at 30% 25%, #8CA39B 0%, #6E877E 75%)}
  .mic svg{width:38%; height:38%}
  /* live level bloom */
  .bloom{position:absolute; inset:0; margin:auto; border-radius:50%;
         background:radial-gradient(circle, rgba(198,135,63,.32), transparent 62%);
         transform:scale(var(--lvl,0)); transition:transform .08s linear; pointer-events:none}

  .hint{font-family:var(--serif); font-size:22px; color:var(--mountain); text-align:center; line-height:1.35}
  .hint .ar{display:block; font-size:16px; color:var(--mist); font-family:var(--sans); margin-top:4px}
  .hint.small{font-size:16px; color:var(--mist)}

  /* ---------------------------------------------------------------- results */
  .results{width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px}
  /* candidate card = one compact row */
  .card{background:var(--cloud); border-radius:var(--r); box-shadow:var(--shadow);
        padding:14px; display:flex; gap:14px; align-items:center; text-align:left;
        opacity:0; transform:translateY(10px); animation:rise .4s ease forwards}
  @keyframes rise{to{opacity:1;transform:none}}
  /* lead card = header row, then full-width detail underneath */
  .card.lead{flex-direction:column; align-items:stretch; padding:18px; gap:16px;
             border:1px solid var(--resin-soft)}
  .card.lead .head{display:flex; align-items:center; gap:14px}

  .thumb{width:64px; height:64px; flex:0 0 auto; border-radius:14px; overflow:hidden;
         display:grid; place-items:center; color:var(--cloud); font-family:var(--serif);
         font-size:26px; background:var(--tile,#3A5C52)}
  .card.lead .thumb{width:84px;height:84px;font-size:34px;border-radius:18px}
  .thumb img{width:100%;height:100%;object-fit:cover}

  .gloss{flex:1; min-width:0; font-family:var(--serif); font-size:22px; color:var(--ink);
         line-height:1.15; word-break:break-word; text-align:left}
  .card.lead .gloss{font-size:28px}
  .gloss .glossar{display:block; font-family:var(--sans); font-size:15px; color:var(--mist);
                  margin-top:3px; direction:rtl; text-align:right}

  .play{flex:0 0 auto; width:52px; height:52px; border-radius:50%; border:none; cursor:pointer;
        background:var(--mountain); color:var(--cloud); display:grid; place-items:center;
        box-shadow:0 6px 16px rgba(31,58,52,.22)}
  .card.lead .play{width:60px; height:60px; background:var(--resin)}
  .play svg{width:42%;height:42%}

  /* the word's own voice, drawn inside its box in place of a letter */
  .thumb-wave{width:78%; height:56%; fill:rgba(255,255,255,.92); display:block}

  /* speaker avatars — big enough for an elder to tap confidently */
  .voices{display:flex; align-items:center; gap:10px; flex-wrap:wrap}
  .av{width:52px;height:52px;border-radius:50%;border:none;cursor:pointer;position:relative;
      display:grid;place-items:center;box-shadow:0 2px 8px rgba(31,58,52,.16)}
  .av svg{width:60%;height:60%}
  .av[aria-pressed="true"]{outline:3px solid var(--resin); outline-offset:2px}

  .sayit{border:1.5px solid var(--mist-2); background:transparent; color:var(--mountain);
         border-radius:16px; padding:15px; font:600 16px/1 var(--sans); text-decoration:none;
         display:flex; align-items:center; justify-content:center; gap:10px; cursor:pointer}
  .sayit .ar{color:var(--mist); font-weight:400}

  /* empty / miss — an invitation, not an apology */
  .empty{width:100%; max-width:460px; background:var(--cloud); border-radius:var(--r);
         box-shadow:var(--shadow); padding:26px 22px; text-align:center}
  .empty h2{font-family:var(--serif); font-weight:500; font-size:24px; color:var(--mountain); margin:0 0 6px}
  .empty p{color:var(--mist); margin:0 0 18px; font-size:15px}
  .empty .ar{display:block; direction:rtl; color:var(--mist); font-size:14px; margin-top:4px}
  .cta{display:inline-flex; align-items:center; gap:10px; background:var(--resin); color:var(--cloud);
       border:none; border-radius:16px; padding:16px 22px; font:600 16px/1 var(--sans); cursor:pointer; text-decoration:none}

  .again{align-self:center; background:transparent; border:none; color:var(--mist);
         font:600 14px/1 var(--sans); padding:12px; cursor:pointer; display:inline-flex; gap:8px; align-items:center}

  .banner{max-width:560px; margin:0 auto; background:#FBEFE0; color:#7A5320; border:1px solid var(--resin-soft);
          border-radius:14px; padding:12px 14px; font-size:14px; text-align:center}
  .hidden{display:none !important}
  /* dev distance readout — off by default, tap the wordmark 3× to reveal */
  .dbg{position:fixed; bottom:8px; left:8px; font:11px/1.4 ui-monospace,monospace; color:var(--mist);
       background:rgba(255,255,255,.7); padding:6px 8px; border-radius:8px; pointer-events:none}

  @media (prefers-reduced-motion:reduce){
    *{animation:none !important; transition:none !important}
  }
  :focus-visible{outline:3px solid var(--resin); outline-offset:3px}
</style>
</head>
<body>
  <header>
    <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M2 26 L11 9 L17 20 L21 13 L30 26 Z" fill="#1F3A34"/>
      <circle cx="24" cy="7" r="3.2" fill="#C6873F"/>
    </svg>
    <span class="wordmark" id="wordmark">Hakli<small>speak to find</small></span>
    <button class="skin" id="skin" aria-label="Change how words are shown"></button>
  </header>

  <main>
    <div class="control">
      <div class="stage" id="stage">
        <span class="ring"></span><span class="ring"></span><span class="ring"></span>
        <span class="bloom" id="bloom"></span>
        <button class="mic" id="mic" aria-label="Hold and speak a word">
          <!-- mic glyph -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>
          </svg>
        </button>
      </div>
      <p class="hint" id="hint">Hold and speak<span class="ar">تكلّم</span></p>
    </div>

    <div class="results hidden" id="results"></div>
  </main>

  <div class="dbg hidden" id="dbg"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, doc, getDoc, collection, query, where, limit, getDocs }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
import { getStorage, ref, getDownloadURL }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

/* ================================================================= CONFIG */
/* Same afd-dev project the recorder uses. Web keys identify a project;
   they authorise nothing — security lives in the rules. */
const firebaseConfig = {
  apiKey:            "AIzaSyDsLxppuVNGLdJGcF85irDxepVL36RaqiY",
  authDomain:        "afd-dev.firebaseapp.com",
  projectId:         "afd-dev",
  storageBucket:     "afd-dev.firebasestorage.app",
  messagingSenderId: "454829954488",
  appId:             "1:454829954488:web:c83d6d16ab17e106956b4d"
};

/* >>> PASTE YOUR CLOUD RUN URL (no trailing slash) <<< */
const EMBED_URL = "https://afd-embed-454829954488.europe-west1.run.app";

/* Confidence gates on cosine distance. PLACEHOLDERS — recalibrate once
   real cross-speaker data exists. Within-speaker self-repeats sat at
   0.14–0.25 in testing, so cross-speaker "same word" will be a bit higher. */
const AUTOPLAY_MAX = 0.35;   // <= this: confident, autoplay the top hit
const MAYBE_MAX    = 0.60;   // <= this: show as candidates ("did you mean")
                             // >  this OR no results: nobody has said it → be first
const RECORDER_URL = "index.html";  // where "say it yourself" goes

/* How the box shows a word. Default is chosen for us so a non-reader does nothing;
   the small header control changes it. Stored locally — no account needed. */
const MODES = ["auto","sound","script"];   // auto = picture → sound → letter
let displayMode = "auto";
try{ const m = localStorage.getItem("afd_display_mode"); if(m && MODES.includes(m)) displayMode = m; }catch(_){}
let lastResults = null;
function setDisplayMode(m){ displayMode = m; try{ localStorage.setItem("afd_display_mode", m); }catch(_){} }

/* ================================================================= setup */
const app   = initializeApp(firebaseConfig);
const db    = getFirestore(app);
const store = getStorage(app);

const $ = id => document.getElementById(id);
const mic = $("mic"), hint = $("hint"), resultsEl = $("results"),
      bloom = $("bloom"), dbg = $("dbg");
let audioEl = new Audio();

/* --------- optional spoken hint (plays a recorded Hakli UI prompt if one
   has been captured; silently skipped if not). */
tryPlayPrompt("find_hint");
async function tryPlayPrompt(key){
  try{
    const s = await getDoc(doc(db, "afd_ui_prompts", key));
    if(!s.exists()) return;
    const d = s.data();
    const path = d.storagePath || d.path;
    if(!path) return;
    const url = await getDownloadURL(ref(store, path));
    const a = new Audio(url); a.play().catch(()=>{});   // autoplay may be blocked; that's fine
  }catch(_){/* no prompt yet */}
}

/* ================================================================= capture */
let mediaRec=null, chunks=[], stream=null, ac=null, holding=false;

async function startHold(){
  if(holding) return; holding=true;
  resultsEl.classList.add("hidden");
  try{
    stream = await navigator.mediaDevices.getUserMedia({audio:true});
  }catch(e){ holding=false; setHint("Let the app use the microphone","اسمح باستخدام الميكروفون"); return; }
  document.body.classList.add("rec"); setHint("Listening…","");
  meter(stream);
  chunks=[];
  mediaRec = new MediaRecorder(stream);
  mediaRec.ondataavailable = e => { if(e.data.size) chunks.push(e.data); };
  mediaRec.onstop = onClip;
  mediaRec.start();
}
function endHold(){
  if(!holding) return; holding=false;
  document.body.classList.remove("rec");
  bloom.style.setProperty("--lvl",0);
  if(mediaRec && mediaRec.state!=="inactive") mediaRec.stop();
  if(ac){ ac.close().catch(()=>{}); ac=null; }
}
function meter(stream){
  try{
    ac = new (window.AudioContext||window.webkitAudioContext)();
    const src=ac.createMediaStreamSource(stream), an=ac.createAnalyser();
    an.fftSize=256; src.connect(an); const buf=new Uint8Array(an.frequencyBinCount);
    (function loop(){
      if(!holding) return;
      an.getByteTimeDomainData(buf);
      let peak=0; for(const v of buf){ const d=Math.abs(v-128)/128; if(d>peak)peak=d; }
      bloom.style.setProperty("--lvl", (0.4+peak*2.2).toFixed(2));
      requestAnimationFrame(loop);
    })();
  }catch(_){}
}

async function onClip(){
  if(stream){ stream.getTracks().forEach(t=>t.stop()); stream=null; }
  const blob = new Blob(chunks, {type: chunks[0]?.type || "audio/webm"});
  if(blob.size < 800){ setHint("Hold a little longer, then speak","تكلّم أطول قليلاً"); return; }
  await runSearch(blob);
}

/* ================================================================= search */
async function runSearch(blob){
  document.body.classList.add("busy"); setHint("Finding…","");
  if(EMBED_URL.includes("PASTE-")){
    banner("Set EMBED_URL to your Cloud Run address in find.html.");
    document.body.classList.remove("busy"); setHint("Hold and speak","تكلّم"); return;
  }
  let data;
  try{
    const fd = new FormData(); fd.append("file", blob, "query.webm");
    const r = await fetch(`${EMBED_URL}/search?top_k=6`, {method:"POST", body:fd});
    if(!r.ok) throw new Error("search "+r.status);
    data = await r.json();
  }catch(e){
    document.body.classList.remove("busy");
    setHint("Couldn't reach the matcher — try again","حاول مرة أخرى");
    document.body.classList.add("has-results"); return;
  }
  document.body.classList.remove("busy");
  const results = (data.results||[]);
  showDbg(results, data.corpus_n);
  await render(results);
}

async function render(results){
  lastResults = results;
  resultsEl.innerHTML=""; hint.classList.add("small");
  const best = results[0];

  if(!best || best.distance > MAYBE_MAX){ renderEmpty(best); return; }

  const confident = best.distance <= AUTOPLAY_MAX;
  setHint(confident ? "Here it is" : "Did you mean…", "");

  // lead card
  const lead = await entryCard(best, true);
  resultsEl.appendChild(lead.el);
  // the rest
  for(const res of results.slice(1)){
    if(res.distance > MAYBE_MAX) break;
    const c = await entryCard(res, false);
    resultsEl.appendChild(c.el);
  }
  resultsEl.classList.remove("hidden"); document.body.classList.add("has-results");

  if(confident && lead.firstPlayable){ playInto(lead.playBtn, lead.firstPlayable); }
}

/* build one entry card: thumbnail, gloss, voice silhouettes, speaker avatars */
async function entryCard(res, lead){
  const el = document.createElement("div");
  el.className = "card" + (lead ? " lead" : "");

  // entry metadata (public). Fall back gracefully if absent.
  let meta={};
  try{ const s = await getDoc(doc(db,"afd_entries",res.entryId)); if(s.exists()) meta=s.data(); }catch(_){}
  const glossEn = meta.gloss || res.gloss || "";
  const glossAr = meta.glossAr || meta.ar || "";
  const tile = domainColor(meta.domain || res.entryId);

  // playable recordings (allowPlayback == true), same query the recorder uses
  const recs = await listPlayable(res.entryId);

  // The box shows the WORD'S VOICE — a waveform of the recording — instead of a
  // letter. It's painted once the envelope resolves (stored, or computed from the
  // audio). A real picture still wins if the entry has one; the letter is only a
  // last resort when there's no audio at all.
  const letterFallback = glossEn ? glossEn.trim()[0].toUpperCase() : "•";
  const scriptLabel = glossAr || meta.ref || "";
  const thumbHtml =
    `<div class="thumb" style="--tile:${tile}" data-img="${escapeHtml(meta.image||"")}" ` +
    `data-pic="${escapeHtml(meta.pic||"")}" data-script="${escapeHtml(scriptLabel)}" ` +
    `data-letter="${escapeHtml(letterFallback)}"></div>`;
  const glossHtml = `<div class="gloss">${escapeHtml(glossEn)}${glossAr?`<span class="glossar">${escapeHtml(glossAr)}</span>`:""}</div>`;
  const playHtml  = `<button class="play" aria-label="Play pronunciation"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>`;

  const firstPlayable = recs[0]?.url || null;

  if(lead){
    // header row (box-waveform · gloss · play), then speaker voices + CTA
    el.innerHTML =
      `<div class="head">${thumbHtml}${glossHtml}${playHtml}</div>` +
      `<div class="voices"></div>`;
  }else{
    // candidate: one compact row
    el.innerHTML = thumbHtml + glossHtml + playHtml;
  }

  const playBtn = el.querySelector(".play");
  const thumbEl = el.querySelector(".thumb");
  let currentUrl = firstPlayable;
  // fill the box per the chosen display mode (picture / sound / script)
  applyBox(thumbEl, displayMode, recs);
  playBtn.addEventListener("click", ()=> currentUrl && playInto(playBtn, currentUrl));

  if(lead){
    // round fauna avatars, one per voice, tap to hear that speaker
    const voices = el.querySelector(".voices");
    recs.forEach(rec=>{
      const b=document.createElement("button");
      b.className="av"; b.style.background=rec.avatar.bg;
      b.setAttribute("aria-label","Play this speaker");
      b.innerHTML=rec.avatar.svg;
      b.addEventListener("click",()=>{
        voices.querySelectorAll(".av").forEach(x=>x.setAttribute("aria-pressed","false"));
        b.setAttribute("aria-pressed","true");
        currentUrl = rec.url;
        if(thumbEl && thumbEl.querySelector("svg")) envelopeFor(rec).then(env=> paintBox(thumbEl, env));
        playInto(playBtn, rec.url);
      });
      voices.appendChild(b);
    });
    // flywheel: one tap to add your own voice
    const say=document.createElement("a");
    say.className="sayit"; say.href=`${RECORDER_URL}#${encodeURIComponent(res.entryId)}`;
    say.innerHTML=`<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
      Say it yourself <span class="ar">سجّل صوتك</span>`;
    el.appendChild(say);
  }

  return { el, playBtn, firstPlayable };
}

async function listPlayable(entryId){
  const out=[];
  try{
    const q=query(collection(db,"afd_entries",entryId,"recordings"),
                  where("allowPlayback","==",true), limit(12));
    const snap=await getDocs(q);
    for(const d of snap.docs){
      const v=d.data(); if(!v.storagePath) continue;
      let url; try{ url=await getDownloadURL(ref(store,v.storagePath)); }catch(_){ continue; }
      out.push({ url, envelope: (Array.isArray(v.envelope)&&v.envelope.length)?v.envelope:null,
                 avatar: faunaAvatar(v.speakerId||v.uid||d.id) });
    }
  }catch(_){}
  return out;
}

function renderEmpty(best){
  hint.classList.add("small"); setHint("", "");
  const div=document.createElement("div");
  div.className="empty";
  div.innerHTML=`
    <h2>No one has said this yet</h2>
    <p>Be the first voice for this word.<span class="ar">لم يقلها أحد بعد — كن أول صوت</span></p>
    <a class="cta" href="${RECORDER_URL}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
      Say it yourself
    </a>`;
  resultsEl.innerHTML=""; resultsEl.appendChild(div);
  resultsEl.classList.remove("hidden"); document.body.classList.add("has-results");
}

/* ================================================================= visuals */
/* =============================================== the word's voice, in its box */
const _envCache = new Map();

function downsampleEnv(frames, n){
  n=n||48; if(!frames||!frames.length) return [];
  const mx=Math.max.apply(null,frames)||1e-9, out=[];
  if(frames.length<=n){ for(const f of frames) out.push(+(f/mx).toFixed(2)); return out; }
  const bin=frames.length/n;
  for(let i=0;i<n;i++){ let pk=0; const s=Math.floor(i*bin),e=Math.floor((i+1)*bin);
    for(let j=s;j<e;j++) if(frames[j]>pk) pk=frames[j]; out.push(+(pk/mx).toFixed(2)); }
  return out;
}

/* stored envelope if the recording has one, else compute it once from the audio
   (so legacy clips get a shape too) and cache by url. */
async function envelopeFor(rec){
  if(rec && rec.envelope && rec.envelope.length) return rec.envelope;
  if(!rec || !rec.url) return null;
  if(_envCache.has(rec.url)) return _envCache.get(rec.url);
  try{
    const ab = await (await fetch(rec.url)).arrayBuffer();
    const ac = new (window.AudioContext||window.webkitAudioContext)();
    const buf = await ac.decodeAudioData(ab); ac.close();
    const ch=buf.getChannelData(0), fr=Math.floor(buf.sampleRate*0.02), frames=[];
    for(let i=0;i<ch.length;i+=fr){ let e=0,n=0;
      for(let j=i;j<Math.min(i+fr,ch.length);j++){ e+=ch[j]*ch[j]; n++; }
      frames.push(Math.sqrt(e/Math.max(n,1))); }
    const env=downsampleEnv(frames,48); _envCache.set(rec.url, env); return env;
  }catch(_){ return null; }
}

/* resample an envelope to n bars and return centered SVG rects for the square box */
function boxBars(env, n){
  n=n||26; const src=env||[], step=src.length? src.length/n : 0; let bars="";
  for(let i=0;i<n;i++){
    const v = src.length ? src[Math.min(src.length-1, Math.floor(i*step))] : 0;
    const h=Math.max(9, v*100), slot=100/n, w=(slot*0.62).toFixed(2),
          x=(i*slot + slot*0.19).toFixed(2), y=((100-h)/2).toFixed(2);
    bars+=`<rect x="${x}" y="${y}" width="${w}" height="${h.toFixed(2)}"/>`;
  }
  return bars;
}

/* paint a box: the waveform if we have an envelope, else the letter as last resort */
function paintBox(thumbEl, env){
  if(!thumbEl) return;
  if(env && env.length){
    thumbEl.innerHTML =
      `<svg class="thumb-wave" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">${boxBars(env)}</svg>`;
  }else{
    thumbEl.textContent = thumbEl.getAttribute("data-letter") || "•";
  }
}

/* fill a box according to the chosen mode:
   auto   → picture (image, else pictograph) → sound-shape → letter
   sound  → the waveform, always
   script → Arabic / transliteration text */
async function applyBox(thumbEl, mode, recs){
  if(!thumbEl) return;
  const d = thumbEl.dataset;
  const asText = t => { thumbEl.textContent = t || (d.letter || "•"); };
  const asWave = async () => paintBox(thumbEl, recs && recs[0] ? await envelopeFor(recs[0]) : null);
  if(mode==="sound")  return asWave();
  if(mode==="script") return asText(d.script || d.pic);
  // auto
  if(d.img){ thumbEl.innerHTML = `<img src="${d.img}" alt="">`; return; }
  if(d.pic){ return asText(d.pic); }
  return asWave();
}

/* deterministic round fauna avatar — pseudonymous, no profile read needed */
const FAUNA = {
  camel:'<path d="M4 17c1-4 2-4 3-6 1 3 4 3 6 3l2-3 1 3c2 0 3 1 3 3v2h-2v-1h-2v1h-2v-1H9v1H6v-1c-1 0-2-.5-2-2z"/>',
  ibex:'<path d="M8 6c-2-3-5-3-5-3 3 1 3 3 4 4-2 1-3 3-3 6 0 3 2 5 5 5s5-2 5-5c0-3-1-5-3-6 1-1 1-3 4-4 0 0-3 0-5 3z"/>',
  bird:'<path d="M4 14c3 0 6-2 8-6 1 3 3 4 6 4-1 2-3 4-7 4-3 0-6-1-7-2z"/>',
  fish:'<path d="M3 12c3-4 8-5 12-3 1-1 3-2 5-2-1 2-1 3 0 5-2 0-4-1-5-2-4 2-9 1-12-3z" transform="translate(0,2)"/>',
  gecko:'<path d="M12 3c-2 0-3 2-3 4 0 1 .5 2 1 3-2 1-4 3-4 6 0 2 2 4 4 4l1-2-1-2c-1 0-2-1-2-2 0-2 3-3 4-3s4 1 4 3c0 1-1 2-2 2l-1 2 1 2c2 0 4-2 4-4 0-3-2-5-4-6 .5-1 1-2 1-3 0-2-1-4-3-4z"/>',
  frog:'<path d="M5 9c0-2 1-3 2-3 0 1 0 2 1 2h8c1 0 1-1 1-2 1 0 2 1 2 3 0 1-1 2-2 2 1 1 2 3 2 5H5c0-2 1-4 2-5-1 0-2-1-2-2z"/>'
};
const FAUNA_KEYS = Object.keys(FAUNA);
function faunaAvatar(seed){
  const h = hashInt(String(seed));
  const hue = h % 360;
  const key = FAUNA_KEYS[h % FAUNA_KEYS.length];
  const bg = `hsl(${hue} 42% 46%)`;
  return { bg, svg:`<svg viewBox="0 0 24 24" fill="rgba(255,255,255,.92)" aria-hidden="true">${FAUNA[key]}</svg>` };
}
function domainColor(seed){ const h=hashInt(String(seed)); return `hsl(${h%360} 34% 34%)`; }
function hashInt(s){ let h=2166136261>>>0; for(let i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619); } return h>>>0; }

/* ================================================================= plumbing */
function playInto(btn, url){
  try{ audioEl.pause(); }catch(_){}
  audioEl = new Audio(url);
  audioEl.play().catch(()=>{});
}
function setHint(en, ar){ hint.innerHTML = escapeHtml(en) + (ar?`<span class="ar">${escapeHtml(ar)}</span>`:""); }
function banner(msg){
  let b=document.querySelector(".banner");
  if(!b){ b=document.createElement("div"); b.className="banner"; document.querySelector("main").prepend(b); }
  b.textContent=msg;
}
function escapeHtml(s){ return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

/* press-and-hold on the mic (pointer covers touch + mouse) */
mic.addEventListener("pointerdown", e=>{ e.preventDefault(); startHold(); });
mic.addEventListener("pointerup",   e=>{ e.preventDefault(); endHold(); });
mic.addEventListener("pointercancel", endHold);
mic.addEventListener("pointerleave", ()=>{ if(holding) endHold(); });
/* keyboard: space/enter to hold */
mic.addEventListener("keydown", e=>{ if((e.key===" "||e.key==="Enter")&&!e.repeat){ e.preventDefault(); startHold(); }});
mic.addEventListener("keyup",   e=>{ if(e.key===" "||e.key==="Enter"){ e.preventDefault(); endHold(); }});

/* the wordless view-changer: cycles picture → sound → script and re-skins */
const SKIN_ICON = {
  auto:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M4 18l5-5 4 4 3-3 4 4"/></svg>`,
  sound: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 9v6M8 5v14M12 8v8M16 4v16M20 10v4"/></svg>`,
  script:`<span class="lbl">أ</span>`,
};
function updateSkinIcon(){ const b=$("skin"); if(b) b.innerHTML = SKIN_ICON[displayMode] || SKIN_ICON.auto; }
$("skin").addEventListener("click", ()=>{
  const next = MODES[(MODES.indexOf(displayMode)+1) % MODES.length];
  setDisplayMode(next); updateSkinIcon();
  if(lastResults) render(lastResults);      // re-skin what's already on screen
});
updateSkinIcon();

/* dev distance readout: tap the wordmark three times */
let taps=0,tt=0;
$("wordmark").addEventListener("click",()=>{ taps++; clearTimeout(tt); tt=setTimeout(()=>taps=0,600);
  if(taps>=3){ dbg.classList.toggle("hidden"); taps=0; } });
function showDbg(results, n){
  if(dbg.classList.contains("hidden")) return;
  dbg.textContent = `corpus ${n??"?"} · ` + results.map(r=>`${r.entryId}:${r.distance}`).join("  ");
}
</script>
</body>
</html>
