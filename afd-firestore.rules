rules_version = '2';
/*  Audio First Dictionary — Firestore rules  (CONSENT REVISION)
 *  ------------------------------------------------------------------
 *  COMPLETE, STANDALONE FILE for the AFD's own Firebase project.
 *  Implements afd-consent-design.md. Deploy as-is.
 *
 *  Consent model:
 *    - Consent is a mutable label over immutable recordings.
 *    - The ONLY mutable fields on a recording are consent / allowPlayback /
 *      withdrawal. Audio, capture, envelope, ownership, and the entry link
 *      are frozen at create.
 *    - A recording's consent may be changed only by its creator uid OR by the
 *      speaker's stewardUid (the account managing that speakerId).
 *    - If the actor is an AGENT (not the speaker themselves), any withdrawal or
 *      deletion MUST carry the speaker's spoken-Hakli confirmation audio
 *      (withdrawal.audioPath) — the "never a third-party lever" guarantee.
 *    - No client hard-delete. "deleted" is a consent state a server purge acts on.
 *
 *  NOTE: get()/exists() calls below are billed reads. They fire only on consent
 *  writes and on private/own reads, which are rare. Unit-test in the emulator
 *  before trusting (firebase emulators:exec).
 *
 *  Deploy:   firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // A real, named account — not the anonymous key used by the prompt tool.
    function notAnon() {
      return signedIn()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A named window (config doc under afd_ui_config) is open while its
    // openUntil is still in the future. Missing doc or a past openUntil →
    // closed. Self-lapsing: a forgotten-open window shuts itself, so nobody has
    // to remember to switch it back off. The steward admin page sets openUntil.
    function windowOpen(name) {
      return exists(/databases/$(database)/documents/afd_ui_config/$(name))
             && get(/databases/$(database)/documents/afd_ui_config/$(name)).data.openUntil > request.time;
    }
    function suggestionsOpen() { return windowOpen('suggestions'); }
    function recordingOpen()   { return windowOpen('recording'); }

    // THE steward — not just any real account. notAnon() alone meant any Google
    // sign-in (i.e. every contributor) could open/close the windows, overwrite a
    // published prompt, or read the suggestion queue. Stewardship is now an
    // explicit list: afd_admins/{uid}, written ONLY by the Admin SDK
    // (scripts/grant-steward.mjs); clients can neither read nor write it.
    // exists() in a rule ignores read rules, so the lookup still works.
    function isSteward() {
      return notAnon()
             && exists(/databases/$(database)/documents/afd_admins/$(request.auth.uid));
    }

    // The speaker card (public). get() is safe only after exists() is checked.
    function speakerExists(sid) {
      return exists(/databases/$(database)/documents/afd_speakers/$(sid));
    }
    function speaker(sid) {
      return get(/databases/$(database)/documents/afd_speakers/$(sid)).data;
    }
    // A NEW speaker code must sit in the caller's own namespace,
    // spk_<first 6 of uid>_… (what the recorder mints). Codes are visible on
    // public recording docs, so without this anyone could create a steward's
    // next code (…_02) first and strand that steward's takes. Existing cards
    // (incl. legacy "spk_01"-style codes) are unaffected — this gates creation.
    function uid6() {           // = the recorder's uid.slice(0,6)
      return request.auth.uid.size() >= 6 ? request.auth.uid[0:6] : request.auth.uid;
    }
    function ownSpeakerCode(sid) {
      return sid.matches('spk_[\\p{L}\\p{N}_-]+')
             && sid.split('_')[1] == uid6()
             && sid.size() > uid6().size() + 5;
    }

    // ---------------------- export-manifest field shapes ----------------------
    // A BCP-47-ish language code: 2–3 letters, optional -subtag. Language-neutral
    // on purpose; WHICH language is the instance's business, not the rules'.
    function langOK(l) {
      return l is string && l.matches('[a-z]{2,3}(-[A-Za-z0-9]{2,8})*');
    }
    function glossOK(g) { return g is string && g.size() > 0 && g.size() <= 80; }
    // Keys = the instance's contact languages (afd-instance.js). Hakli: ar, en.
    function glossesOK(gs) {
      return gs is map && gs.keys().hasOnly(['ar','en']) && gs.size() > 0
             && (!('ar' in gs) || glossOK(gs.ar))
             && (!('en' in gs) || glossOK(gs.en));
    }

    // ------------------------------ word entries ------------------------------
    match /afd_entries/{entryId} {
      allow read: if true;

      // Seeded entries are written by the admin script (the Admin SDK bypasses
      // rules, so those aren't constrained here). A signed-in contributor may
      // CREATE a new entry from the app — audio-first, so gloss text is optional.
      // "Show it" (add.html) may give the new word a face at create time: an
      // emoji (pic) and/or a photo (image). The image may only be THIS account's
      // own upload for THIS entry (afd_pics/{uid}/{entryId}.jpg, public URL with
      // no token), so an entry can't hotlink someone else's picture or any
      // other site. With neither, the identicon carries the visual. They
      // may never edit or delete an entry: relabel / merge / split is a future
      // reviewer tool with its own authorisation model, so update+delete stay
      // closed. This is what turns the fixed seed corpus into a growable one
      // without opening it to vandalism.
      allow create: if notAnon()
                    && request.resource.data.source == 'user'
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasOnly(
                         ['source','createdBy','createdAt','gloss','glossAr','domain','pic','image',
                          'lang','concepts','glosses'])
                    // Export-manifest fields. lang = the word's language (the
                    // instance default, afd-instance.js); concepts starts empty
                    // (linking is a later steward step); glosses is keyed by the
                    // instance's contact languages ONLY — keep this key list in
                    // step with AFDInstance.contactLanguages. `access` is reserved
                    // and server-only, so a client can't set it.
                    && (!('lang' in request.resource.data) || langOK(request.resource.data.lang))
                    && (!('concepts' in request.resource.data)
                        || (request.resource.data.concepts is list
                            && request.resource.data.concepts.size() == 0))
                    && (!('glosses' in request.resource.data) || glossesOK(request.resource.data.glosses))
                    && (!('gloss'   in request.resource.data) ||
                        (request.resource.data.gloss   is string && request.resource.data.gloss.size()   <= 80))
                    && (!('glossAr' in request.resource.data) ||
                        (request.resource.data.glossAr is string && request.resource.data.glossAr.size() <= 80))
                    && (!('domain'  in request.resource.data) ||
                        (request.resource.data.domain  is string && request.resource.data.domain.size()  <= 40))
                    && (!('pic'     in request.resource.data) ||
                        (request.resource.data.pic     is string && request.resource.data.pic.size() > 0
                         && request.resource.data.pic.size() <= 32))
                    && (!('image'   in request.resource.data) ||
                        request.resource.data.image ==
                          'https://firebasestorage.googleapis.com/v0/b/afd-dev.firebasestorage.app/o/afd_pics%2F'
                          + request.auth.uid + '%2F' + entryId + '.jpg?alt=media');
      // Two narrow edits, nothing else about an entry ever changes:
      //  • REMOVE MY WORD — the creator of a contributed word may take it back:
      //    set removedAt (once, to now). The app erases their voices on it at the
      //    same time; the dictionary hides it at once and the purge reaps it once
      //    no recordings remain. Only the creator, only their own word.
      //  • TAGS — free labels (a dialect, "Mehri", "loanword"…), set by the
      //    word's creator, or by a steward on any word (seeded ones included).
      //    Up to 6 tags of 1–40 characters each.
      function tagOK(t) { return t is string && t.size() > 0 && t.size() <= 40; }
      function tagsOK(ts) {
        return ts is list && ts.size() <= 6
               && (ts.size() < 1 || tagOK(ts[0])) && (ts.size() < 2 || tagOK(ts[1]))
               && (ts.size() < 3 || tagOK(ts[2])) && (ts.size() < 4 || tagOK(ts[3]))
               && (ts.size() < 5 || tagOK(ts[4])) && (ts.size() < 6 || tagOK(ts[5]));
      }
      function isCreator() {
        return notAnon()
               && resource.data.get('source', '') == 'user'
               && resource.data.get('createdBy', '') == request.auth.uid;
      }
      function onlyChanged(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      //  • STEWARD REVIEW (steward.html) — on a contributed word only:
      //      reviewedAt  — "looks fine", set to now; takes it out of the queue.
      //      hiddenAt    — hide the word (set to now, once) or show it again
      //                    (delete the field). Reversible, and it touches no
      //                    voice: consent stays each speaker's own.
      //      image / pic — take a picture down: each may only be REMOVED,
      //                    never set (the steward deletes the photo bytes too).
      function isContributed() { return resource.data.get('source', '') == 'user'; }
      //  • EDIT THE WORD'S FACE (10-14) — English and Arabic text and the emoji.
      //    A steward on any word (seeded ones included: the seed script leaves an
      //    edited word's text alone from then on); a contributor on their own
      //    word. Stamped with who and when. Voices, photo, tags and everything
      //    else are untouched by this branch. Glosses may be cleared (an
      //    audio-first word needs none); `glosses` then goes with them.
      function textOK(k) {
        return !(k in request.resource.data)
               || (request.resource.data[k] is string && request.resource.data[k].size() <= 80);
      }
      function picOK() {
        return !('pic' in request.resource.data)
               || (request.resource.data.pic is string
                   && request.resource.data.pic.size() > 0 && request.resource.data.pic.size() <= 32);
      }
      function faceEditOK() {
        return onlyChanged(['gloss','glossAr','glosses','pic','editedAt','editedBy'])
               && !('removedAt' in resource.data)
               && request.resource.data.editedAt == request.time
               && request.resource.data.editedBy == request.auth.uid
               && textOK('gloss') && textOK('glossAr') && picOK()
               && (!('glosses' in request.resource.data) || glossesOK(request.resource.data.glosses));
      }
      allow update: if (isCreator()
                        && !('removedAt' in resource.data)
                        && onlyChanged(['removedAt'])
                        && request.resource.data.removedAt == request.time)
                    || ((isCreator() || isSteward())
                        && onlyChanged(['tags'])
                        && tagsOK(request.resource.data.tags))
                    || ((isCreator() || isSteward()) && faceEditOK())
                    || (isSteward() && isContributed()
                        && onlyChanged(['reviewedAt'])
                        && request.resource.data.reviewedAt == request.time)
                    || (isSteward() && isContributed()
                        && onlyChanged(['hiddenAt'])
                        && (!('hiddenAt' in request.resource.data)
                            || (!('hiddenAt' in resource.data)
                                && request.resource.data.hiddenAt == request.time)))
                    || (isSteward() && isContributed()
                        && onlyChanged(['image', 'pic'])
                        && (!('image' in request.resource.data)
                            || request.resource.data.image == resource.data.get('image', null))
                        && (!('pic' in request.resource.data)
                            || request.resource.data.pic == resource.data.get('pic', null)));
      allow delete: if false;

      // ------------------------------- spellings -------------------------------
      // The word itself, written in letters (for Hakli: Arabic letters, tagged
      // "qhk-Arab"). Any number per card, one per writer: the doc id IS the
      // writer's uid, so a second save is an edit, a retry can't double up, and
      // attribution can't be forged. No spelling is canonical, so there is no
      // ranking or "approved" flag. A spelling is a label, not a recording:
      // its writer may change or remove it outright. A steward may hide one
      // (and show it again) but never edit what someone wrote.
      // Reads are open (the dictionary reads every card's spellings in one
      // collection-group query; see the {path=**} rule below). Hidden ones are
      // filtered in the page: hiding is curation, not privacy.
      match /spellings/{writer} {
        function spellOK(d) {
          return d.text is string && d.text.size() > 0 && d.text.size() <= 60
                 && d.searchKey is string && d.searchKey.size() <= 60
                 && langOK(d.lang);
        }
        function spellChanged(keys) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
        }
        allow read: if true;
        allow create: if notAnon()
                      && writer == request.auth.uid
                      && request.resource.data.keys().hasOnly(['text','searchKey','lang','by','at'])
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.at == request.time
                      && spellOK(request.resource.data)
                      && exists(/databases/$(database)/documents/afd_entries/$(entryId));
        allow update: if (notAnon()
                          && writer == request.auth.uid
                          && spellChanged(['text','searchKey','lang','at'])
                          && request.resource.data.at == request.time
                          && spellOK(request.resource.data))
                      || (isSteward()
                          && spellChanged(['hiddenAt'])
                          && (!('hiddenAt' in request.resource.data)
                              || (!('hiddenAt' in resource.data)
                                  && request.resource.data.hiddenAt == request.time)));
        allow delete: if notAnon() && writer == request.auth.uid;
      }

      // -------------------------- contributed recordings --------------------------
      match /recordings/{recordingId} {

        // Whoever may manage this recording's consent: its creator, or the
        // speaker's current steward.
        function isManager() {
          return resource.data.uid == request.auth.uid
                 || (speakerExists(resource.data.speakerId)
                     && speaker(resource.data.speakerId).stewardUid == request.auth.uid);
        }
        // True when the actor IS the speaker (self-representing), not an agent.
        function actorIsSpeakerSelf() {
          return speakerExists(resource.data.speakerId)
                 && speaker(resource.data.speakerId).stewardUid == request.auth.uid
                 && speaker(resource.data.speakerId).viaAgent == false;
        }
        // Only the consent label may move — the atom is frozen.
        function onlyConsentChanged() {
          return request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['consent', 'allowPlayback', 'withdrawal']);
        }
        // Re-instating to public needs no artifact. A self-speaker needs none.
        // An AGENT withdrawing or deleting must attach the spoken confirmation.
        function withdrawalArtifactOK() {
          return request.resource.data.consent == 'public'
                 || actorIsSpeakerSelf()
                 || (('withdrawal' in request.resource.data)
                     && request.resource.data.withdrawal.audioPath is string);
        }

        // Public listening = currently-public only (denormalised flag keeps this
        // a simple indexed query). A manager can always read their own.
        allow read: if resource.data.allowPlayback == true
                    || (notAnon() && isManager());

        // storagePath is trusted downstream — the purge Function deletes the
        // object it names, the embed trigger matches uploads back to this doc —
        // so it may only ever name THIS account's own copy of THIS recording.
        // Otherwise a doc could point at someone else's audio and, once erased,
        // have the purge delete it.
        function storagePathOK() {
          return !('storagePath' in request.resource.data)
                 || request.resource.data.storagePath
                      in ['afd/' + request.auth.uid + '/' + recordingId + '.webm',
                          'afd/' + request.auth.uid + '/' + recordingId + '.m4a',
                          // an imported voice note, re-encoded on the phone
                          'afd/' + request.auth.uid + '/' + recordingId + '.wav'];
        }

        allow create: if notAnon()
                      // Explicit allowlist — keep in step with uploadClip() in
                      // recorder.html. Server-owned fields (embedding, reps,
                      // nReps, …, written by the embed trigger) and the consent
                      // `withdrawal` record can't be planted by a client.
                      && request.resource.data.keys().hasOnly(
                           ['recordingId','entryId','gloss','domain','speakerId',
                            'phase','type','promptTier','repetitionIndex','capture',
                            'qc','envelope','storagePath','recordedAt','uid',
                            'consent','viaAgent','allowPlayback','uploadedAt','source',
                            'lang'])
                      // the language spoken in this take (instance default).
                      // Optional so a take kept on a phone before this field
                      // existed can still upload; the backfill fills it in.
                      && (!('lang' in request.resource.data) || langOK(request.resource.data.lang))
                      && request.resource.data.uid == request.auth.uid
                      // the doc's own ids must match its place in the tree
                      && request.resource.data.entryId == entryId
                      && (!('recordingId' in request.resource.data)
                          || request.resource.data.recordingId == recordingId)
                      && storagePathOK()
                      && request.resource.data.speakerId is string
                      // Studio protocol: 44.1 kHz+. One exception, flagged so research
                      // can filter it: a WhatsApp voice note (compressed, ~16 kHz) that
                      // a steward imports on a speaker's behalf (viaAgent) — for
                      // speakers who will only ever send a voice note.
                      && (!('source' in request.resource.data)
                          || request.resource.data.source == 'voicenote')
                      && (request.resource.data.capture.sampleRate >= 44100
                          || (request.resource.data.get('source', '') == 'voicenote'
                              && request.resource.data.viaAgent == true
                              && request.resource.data.capture.sampleRate >= 8000))
                      && request.resource.data.gloss is string
                      && request.resource.data.consent == 'public'
                      && request.resource.data.allowPlayback is bool
                      // A take may only attach to a speaker card THIS account
                      // stewards (or to a speaker with no card yet — the first
                      // upload creates it right after). Stops a colliding or
                      // mistyped code from filing a voice under someone else's
                      // speaker and consent.
                      // A brand-new code must also be this account's own
                      // (ownSpeakerCode), checked here too so a refused code
                      // fails BEFORE anything is written, not at the card.
                      && (speakerExists(request.resource.data.speakerId)
                          ? speaker(request.resource.data.speakerId).stewardUid == request.auth.uid
                          : ownSpeakerCode(request.resource.data.speakerId))
                      // Withdrawal is the speaker's own act and wins: while the
                      // card is withdrawn/erased, a new take (incl. one uploading
                      // late after signal returns) can only arrive hidden.
                      // Restoring stays the deliberate roster "share again".
                      && (request.resource.data.allowPlayback == false
                          || !speakerExists(request.resource.data.speakerId)
                          || speaker(request.resource.data.speakerId).consent == 'public');

        // The consent label is the only mutable thing.
        allow update: if notAnon()
                      && isManager()
                      && onlyConsentChanged()
                      && request.resource.data.consent in ['public','withdrawn','deleted']
                      // the playback flag can never contradict the label: only a
                      // 'public' take may be playable
                      && (request.resource.data.consent == 'public'
                          || request.resource.data.allowPlayback == false)
                      // and, as on create, a withdrawn/erased speaker card wins:
                      // making a take playable needs the card public first (the
                      // roster's "share again" flips the card, then its takes)
                      && (request.resource.data.allowPlayback == false
                          || !speakerExists(resource.data.speakerId)
                          || speaker(resource.data.speakerId).consent == 'public')
                      && withdrawalArtifactOK()
                      // ownership and speaker link can never be reassigned
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.speakerId == resource.data.speakerId;

        // Destruction is server-side (purge Function on consent == 'deleted').
        allow delete: if false;
      }
    }

    // --------------------------- speaker profiles ---------------------------
    // Keyed by speakerId, NOT uid — one agent can steward many speakers.
    // Public card: masking + bulk-consent + withdrawn categories + steward uid.
    // No town/tribe here; those live in the steward-only private subdoc.
    match /afd_speakers/{speakerId} {
      allow read: if true;

      // DEFENSE IN DEPTH: the public card is world-readable, so the RULE — not
      // just client discipline — forbids any identifying field here. Town, tribe,
      // age and gender live ONLY in the /private subdoc below; this allowlist
      // makes it structurally impossible for them to surface on the card, now or
      // after any future client change. Keep in step with the two writers of this
      // doc: saveSpeaker() in recorder.html and the grant stub in afd-card.js.
      // NB (migration): on update this checks the FULL merged doc, so a legacy
      // card still carrying a stray field (e.g. pre-fix origin) will be frozen —
      // even a plain consent flip is denied — until it is cleaned. Clean or reset
      // existing speaker docs before deploying, or stage by dropping the update
      // line first. See scripts/reset-speakers.mjs / scripts/export-origins.mjs.
      function speakerCardFieldsOK() {
        return request.resource.data.keys().hasOnly(
          ['uid','stewardUid','speakerId','viaAgent','masked','consent','grant','updatedAt']);
      }

      allow create: if notAnon()
                    && ownSpeakerCode(speakerId)
                    && request.resource.data.get('speakerId', speakerId) == speakerId
                    && request.resource.data.stewardUid == request.auth.uid
                    && request.resource.data.consent in ['public','withdrawn']
                    && speakerCardFieldsOK();

      // Only the steward may change consent/masking, and the steward may not be
      // silently reassigned (claiming an account later is a deliberate flow).
      allow update: if notAnon()
                    && resource.data.stewardUid == request.auth.uid
                    && request.resource.data.stewardUid == resource.data.stewardUid
                    && speakerCardFieldsOK();

      allow delete: if false;

      // Speaker origin visibility (ROADMAP), three tiers:
      //  1. steward-only by default — the speaker's steward reads and writes
      //     /private (town, tribe, age band, gender);
      //  2. qualified dialect readers — accounts given the `dialectReader` custom
      //     claim (scripts/grant-reader.mjs, Admin SDK) may READ /private, for
      //     variety analysis; never write;
      //  3. opt-in public — the TOWN ONLY, in /public/origin, and only while the
      //     speaker's own grant says publicOrigin and the card is public. Tribe,
      //     age and gender never leave /private.
      function isDialectReader() {
        return notAnon() && request.auth.token.get('dialectReader', false) == true;
      }
      match /private/{doc} {
        allow read: if notAnon()
          && (get(/databases/$(database)/documents/afd_speakers/$(speakerId)).data.stewardUid == request.auth.uid
              || isDialectReader());
        allow write: if notAnon()
          && get(/databases/$(database)/documents/afd_speakers/$(speakerId)).data.stewardUid == request.auth.uid;
      }
      match /public/{doc} {
        function card() { return get(/databases/$(database)/documents/afd_speakers/$(speakerId)).data; }
        function townShown() {
          return card().get('consent', '') == 'public'
                 && card().get('grant', {}).get('publicOrigin', false) == true;
        }
        allow read: if townShown();
        // only this one doc, only the town, only by the speaker's steward, only
        // while the speaker has chosen it
        allow create, update: if notAnon()
          && doc == 'origin'
          && card().stewardUid == request.auth.uid
          && card().get('grant', {}).get('publicOrigin', false) == true
          && request.resource.data.keys().hasOnly(['town', 'updatedAt'])
          && request.resource.data.town is string
          && request.resource.data.town.size() > 0
          && request.resource.data.town.size() <= 80;
        // the steward takes it down (when the speaker turns it off)
        allow delete: if notAnon() && card().stewardUid == request.auth.uid;
      }
    }

    // --------------------------- contributor (steward) profile ---------------------------
    // One doc per account — the steward's OWN public identity, kept separate
    // from the per-speaker records they manage (and untouched by the
    // afd_speakers speakerId re-key). Presence-based, mirroring afd_avatars in storage:
    //   • "obscure" (default) leaves the contributor behind the deterministic
    //     fauna avatar, exactly as today;
    //   • "known" surfaces displayName (and, via storage, an avatar) on that
    //     steward's OWN voices only — never on voices they recorded by proxy.
    // The rule enforces the presence guarantee itself: no displayName may be
    // stored while obscure, so a name can't linger publicly after switching back.
    match /afd_stewards/{uid} {
      allow read: if true;
      allow create, update: if notAnon()
        && request.auth.uid == uid
        && request.resource.data.visibility in ['obscure','known']
        && ( !('displayName' in request.resource.data)
             || ( request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 80 ) )
        && ( request.resource.data.visibility == 'known'
             || !('displayName' in request.resource.data)
             || request.resource.data.displayName == '' );
      allow delete: if false;
    }

    // --------------------------- UI voice prompts ---------------------------
    // Spoken Hakli interface, recorded remotely over anonymous sign-in and
    // boxed into its own namespace — it can never reach the corpus.
    match /afd_ui_prompts/{key} {
      allow read:  if true;
      // Live-on-record, but only while the recording window is open — publishing
      // a clip is exactly this doc write (status:"recorded"), so a closed window
      // stops new anonymous publishes without disturbing anything already live.
      // A real steward account is never gated. The afd_ui/ audio in Storage
      // reads this same window (afd-storage.rules), so it closes there too.
      allow write: if signedIn() && (recordingOpen() || isSteward());
    }

    // ------------------- Arabic prompt-edit suggestions --------------------
    // Dhofari-Arabic proposals for the UI prompt strings, captured at the
    // source (the speaker recording the prompts). Text only, append-only, and
    // deliberately WALLED OFF from the corpus and from the live prompt docs —
    // a suggestion can never become app content on its own. Marty reviews the
    // queue and commits approved wording to the source table in git; git stays
    // the source of truth.
    //
    // Suggesters are on the same ANONYMOUS session the prompt tool uses, so
    // create is gated by a global switch Marty controls, not by identity:
    // open the window when a trusted speaker is doing a pass, keep it shut
    // otherwise. When named reviewers (real accounts) exist later, add
    // `|| onAllowlist()` to the create guard below — a one-line change, and the
    // switch keeps working for anonymous passes alongside it.
    // (suggestionsOpen() and the openUntil model live with the window helpers up top.)
    // The switch doc itself: public-read so the tool can show/hide the affordance;
    // only the steward may flip it — and only the openUntil timestamp.
    match /afd_ui_config/{key} {
      allow read:  if true;
      // Only openUntil may be SET — checked on the fields this write changes, so
      // a leftover field on an old doc (e.g. the retired `open`) can't lock the
      // steward out, but no new field can be added.
      allow write: if isSteward()
                   && (resource == null
                         ? request.resource.data.keys().toSet()
                         : request.resource.data.diff(resource.data).affectedKeys()
                      ).hasOnly(['openUntil'])
                   && request.resource.data.openUntil is timestamp;
    }
    match /afd_ui_suggestions/{id} {
      allow read:   if isSteward();             // only the steward reviews the queue
      allow create: if signedIn()
                    && suggestionsOpen()
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasOnly(
                         ['key','arSuggested','arSeen','note','by','createdAt'])
                    && request.resource.data.key is string
                    && request.resource.data.key.size() <= 60
                    && request.resource.data.arSuggested is string
                    && request.resource.data.arSuggested.size() > 0
                    && request.resource.data.arSuggested.size() <= 400
                    && request.resource.data.arSeen is string
                    && request.resource.data.arSeen.size() <= 400
                    && (!('note' in request.resource.data)
                        || (request.resource.data.note is string
                            && request.resource.data.note.size() <= 300));
      allow update, delete: if false;           // append-only; resolved in git
    }

    // ------------------------------ everything else ------------------------------
    // Steward list — Admin SDK only (scripts/grant-steward.mjs). Closed to client
    // writes and listing; spelled out here so nobody "fixes" it open later.
    // One exception: an account may GET its own doc, so the app can tell a
    // steward (and show steward-only controls). It reveals only "am I one?" —
    // nobody can list the stewards or look up anyone else.
    match /afd_admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Every card's spellings in one query (the dictionary list). Collection-
    // group reads match this rule, not the nested one, so it has to be here.
    // Read-only: writes go through afd_entries/{id}/spellings/{writer} above.
    match /{path=**}/spellings/{writer} {
      allow read: if true;
    }

    // Field error log (10-16): afd-core's report() — a failed search, share or
    // upload, or an uncaught page error. Anyone may ADD one, signed in or not
    // (most people searching never sign in), but only in this exact, thin
    // shape: no uid, no user agent, short strings, the server's own time, and
    // an expiry at most 31 days out (a Firestore TTL policy on expireAt deletes
    // them; see DEPLOY.md). Only stewards read or clear them. Never edited.
    match /afd_client_errors/{id} {
      function shortStr(k, n) {
        return !(k in request.resource.data)
               || (request.resource.data[k] is string && request.resource.data[k].size() <= n);
      }
      allow create: if request.resource.data.keys().hasAll(['page','where','code','at','expireAt'])
                    && request.resource.data.keys().hasOnly(
                         ['page','where','code','msg','build','online','os','at','expireAt'])
                    && request.resource.data.page  is string && request.resource.data.page.size()  <= 40
                    && request.resource.data.where is string && request.resource.data.where.size() <= 60
                    && request.resource.data.code  is string && request.resource.data.code.size()  <= 80
                    && shortStr('msg', 300) && shortStr('build', 16)
                    && (!('online' in request.resource.data) || request.resource.data.online is bool)
                    && (!('os' in request.resource.data) || request.resource.data.os in ['ios','android','other'])
                    && request.resource.data.at == request.time
                    && request.resource.data.expireAt is timestamp
                    && request.resource.data.expireAt <= request.time + duration.value(31, 'd');
      allow read, delete: if isSteward();
      allow update: if false;
    }

    // Usage counts (10-17): afd-core's track() — a search and how it came out,
    // a voice played, a take kept, a step on Add. Like the error log: anyone may
    // ADD one, signed in or not, in this exact thin shape — what happened, the
    // page, the display mode, build, online, OS family, a short label or two and
    // a number. No uid, no session or device id, no words. The server's own
    // time; expiry at most 92 days out (TTL on expireAt). Stewards read them
    // (the Stats tab); only the server's digest deletes or rolls them up.
    match /afd_events/{id} {
      function evStr(k, n) {
        return !(k in request.resource.data)
               || (request.resource.data[k] is string && request.resource.data[k].size() <= n);
      }
      allow create: if request.resource.data.keys().hasAll(['ev','page','at','expireAt'])
                    && request.resource.data.keys().hasOnly(
                         ['ev','v','x','n','page','mode','build','online','os','at','expireAt'])
                    && request.resource.data.ev   is string && request.resource.data.ev.size()   <= 24
                    && request.resource.data.page is string && request.resource.data.page.size() <= 40
                    && evStr('v', 24) && evStr('x', 24) && evStr('build', 16)
                    && (!('n' in request.resource.data)
                          || (request.resource.data.n is int
                              && request.resource.data.n >= 0 && request.resource.data.n <= 10000000))
                    && (!('mode' in request.resource.data) || request.resource.data.mode in ['auto','sound','script'])
                    && (!('online' in request.resource.data) || request.resource.data.online is bool)
                    && (!('os' in request.resource.data) || request.resource.data.os in ['ios','android','other'])
                    && request.resource.data.at == request.time
                    && request.resource.data.expireAt is timestamp
                    && request.resource.data.expireAt <= request.time + duration.value(92, 'd');
      allow read: if isSteward();
      allow update, delete: if false;
    }

    // Totals the watch function (watch/main.py) keeps: afd_stats/public — the
    // counter on Help (words · voices · speakers), public on purpose; every
    // other doc (day_YYYY-MM-DD rollups, the watch state) is for stewards.
    // Written only by the server.
    match /afd_stats/{id} {
      allow read: if id == 'public' || isSteward();
      allow write: if false;
    }

    // Search vectors (10-19): afd_vectors/{recordingId}, written by the embed
    // trigger and read by the matcher — both server-side, so no client ever
    // reads or writes them. Kept apart from the recording, which every phone
    // that opens a word downloads. (Said here for clarity; the rule below
    // already refuses it.)
    match /afd_vectors/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
